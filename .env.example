# Agent Desk — environment reference. Copy to .env for LOCAL development only.
# Production: use per-service secret files (secrets/desk.env, secrets/controlplane.env, secrets/postgres.env; chmod 600),
# never one shared .env. Generate random values with:  python scripts/generate_keys.py secrets
# NEVER commit real values. Every *_SECRET/*_KEY/*_PAT/*_TOKEN/*_PASSWORD value is registered with the log redactor.

# --- environment / role -------------------------------------------------------
ENV=development                     # development | production   (production refuses unsafe configuration at start-up)
SERVICE_ROLE=all                    # all | desk | runtime | controlplane | scraper
DEBUG=false
LOG_LEVEL=INFO

# --- domain (Gate 3) ----------------------------------------------------------
BASE_DOMAIN=example.com             # the MLH domain YOU own. Never invented, never purchased by this software.
DESK_HOST=desk.example.com          # default: desk.${BASE_DOMAIN}
DEMO_HOST=demo.example.com          # default: demo.${BASE_DOMAIN}
PUBLIC_SCHEME=https                 # http only for local development
# PUBLIC_PORT=8000                  # local development only; must be unset in production
HSTS_ENABLED=true                   # enable once every subdomain of BASE_DOMAIN serves HTTPS

# --- storage ------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://agentdesk_app:CHANGE_ME@postgres:5432/agentdesk   # local default: sqlite+aiosqlite:///./var/agentdesk.db
REDIS_URL=redis://redis:6379/0      # empty → in-process limiter (development only; production requires Redis)

# --- web security -------------------------------------------------------------
SESSION_SECRET=...                  # ≥32 random chars
CSRF_SECRET=...                     # ≥32 random chars, different from SESSION_SECRET
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
REAUTH_WINDOW_MINUTES=10
TRUSTED_PROXY_CIDRS=172.30.0.0/24   # Caddy's private network; X-Forwarded-For is ignored from anywhere else
API_TOKEN_SECRET=                   # optional machine API bearer tokens; empty → token auth disabled

# --- GoDaddy ANS (CONTROL PLANE ONLY — never give these to desk/runtime/scraper) ----
GODADDY_PAT=...                     # production PAT / event credential. Sent only to GODADDY_API_BASE.
GODADDY_API_BASE=https://api.godaddy.com      # or https://api.ote-godaddy.com (OTE never satisfies Gate 4)
ANS_AUTH_SCHEME=bearer              # bearer (PAT)  |  sso-key (classic key+secret) — official sources disagree; both are supported
GODADDY_API_KEY=
GODADDY_API_SECRET=
ANS_AGENT_VERSION=1.0.0             # bare semver; a failed registration can burn a version → bump on retry
ANS_TRUST_ANCHOR_PATH=              # PEM bundle of the OFFICIAL ANS CA, provisioned by you. Empty → chain check reports INCOMPLETE
ANS_TRUST_ANCHOR_SHA256=            # optional comma-separated SHA-256 pins for that bundle
KEYS_DIR=./secrets/keys             # ANS private keys (0600). Mounted into the control plane only.
ARTIFACTS_DIR=./artifacts           # redacted, non-secret evidence files

# --- service wiring (production split) ----------------------------------------
SCRAPER_URL=                        # e.g. http://scraper:8000 ; empty → in-process crawler
CONTROLPLANE_URL=                   # e.g. http://controlplane:8000 ; empty → in-process registration
CONTROLPLANE_TOKEN=                 # shared by desk + controlplane only

# --- LLM (pick ONE provider; "none" keeps every gate testable with deterministic answers) ----
LLM_PROVIDER=none                   # anthropic | openai | gemini | none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_DAILY_CALLS_PER_PRINCIPAL=200
LLM_DAILY_CALLS_GLOBAL=2000

# --- circuit breakers (kill switches) -------------------------------------------
DISABLE_AGENT_CREATION=false
DISABLE_EXTERNAL_FETCH=false
DISABLE_REMOTE_AGENT_CALLS=false
DISABLE_LLM=false
READ_ONLY_MODE=false

# --- one-time owner bootstrap (python -m app.cli create-owner); unset afterwards ----
OWNER_EMAIL=
OWNER_PASSWORD=
