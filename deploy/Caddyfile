# Agent Desk — Caddy is the ONLY public ingress (80/443). Validate with:  caddy validate --config deploy/Caddyfile
{
	email {$ACME_EMAIL}
	# Do not auto-308 :80 — ANS HTTP-01 is checked in the clear and does not follow redirects.
	# Use TLS-ALPN for our own certificates so Caddy does not steal /.well-known/acme-challenge/.
	auto_https disable_redirects
	cert_issuer acme {
		disable_http_challenge
		email {$ACME_EMAIL}
	}
	# Tenant hosts get certificates on demand, but ONLY if the app confirms the host is a served agent.
	on_demand_tls {
		ask http://desk:8000/internal/tls-ask
	}
	servers {
		timeouts {
			read_header 10s
			read_body 15s
			idle 60s
		}
		max_header_size 16KB
	}
}

(agentdesk) {
	# Hard request-size cap at the edge (the app enforces the same limit again).
	request_body {
		max_size 256KB
	}

	# Internal endpoints never exist on the public side.
	@internal path /internal /internal/*
	respond @internal 404

	header {
		-Server
		-Via
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# The app sets the full CSP on every response; this is the fallback for proxy-generated errors.
		?Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
	}

	reverse_proxy desk:8000 {
		# Client-supplied forwarding headers are discarded; the app trusts X-Forwarded-For only from this proxy's network.
		header_up X-Forwarded-For {remote_host}
		header_up -X-Forwarded-Host
		header_up -Forwarded
		header_up -X-Real-IP
		transport http {
			dial_timeout 3s
			response_header_timeout 60s
		}
	}

	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>Authorization delete
				request>headers>Cookie delete
				request>headers>X-Csrf-Token delete
				request>headers>X-Api-Key delete
				resp_headers>Set-Cookie delete
				request>uri query {
					delete token
					delete key
					delete code
					delete state
				}
			}
		}
	}
}

# ANS HTTP-01 challenges are public tokens served as exact files (no secrets).
(acme_http01) {
	handle_path /.well-known/acme-challenge/* {
		root * /acme-http01
		header Content-Type "text/plain"
		file_server
	}
}

# Serve the challenge on :80 too: ACME HTTP-01 starts in the clear; everything else 308s to HTTPS.
http://desk.{$BASE_DOMAIN}, http://demo.{$BASE_DOMAIN} {
	import acme_http01
	handle {
		redir https://{host}{uri} 308
	}
}

# Explicit hosts (Gate 2/3): certificates are obtained automatically via Let's Encrypt.
desk.{$BASE_DOMAIN}, demo.{$BASE_DOMAIN} {
	import acme_http01
	import agentdesk
}
